<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 提醒通知权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- AI 问需要访问用户自配服务商的接口；仅在用户主动使用 AI 时联网 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 精确闹钟：上课 / 任务 / 睡眠提醒准时触发。
         Android 14（API 34）起该权限对新安装应用默认不授予，未授予时
         ExactAlarms 自动降级为非精确闹钟，设置页提供授权入口。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 开机 / 应用更新后重排闹钟 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 设置页「忽略电池优化」入口：缺此权限时系统授权弹窗会被静默拒绝。
         注意：Play 商店对该权限有政策限制，上架 Play 前请移除本项与该入口。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 专注倒计时前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Android 11+ 包可见性：跳转国产 ROM 自启动管理页需要能解析这些组件 -->
    <queries>
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.iqoo.secure" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.meizu.safe" />
        <package android:name="com.samsung.android.sm" />
        <!-- AI 问语音输入：探测系统语音识别服务（ACTION_RECOGNIZE_SPEECH） -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".SanxingApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Sanxing">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Sanxing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 今日课程小组件（Glance） -->
        <receiver
            android:name=".widget.TodayCoursesWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_courses_widget_info" />
        </receiver>

        <!-- 本周课表迷你小组件（Glance） -->
        <receiver
            android:name=".widget.WeekMiniWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/week_mini_widget_info" />
        </receiver>

        <!-- 应用内语言切换：Android 12 及以下由 appcompat 回退存储语言偏好 -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- 精确闹钟统一接收者（仅本应用内部调度，不导出） -->
        <receiver
            android:name=".notification.AppAlarmReceiver"
            android:exported="false" />

        <!-- 开机 / 应用更新 / 系统时间变化后重排提醒 -->
        <receiver
            android:name=".notification.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <!-- 用户在系统设置里授予 / 撤销精确闹钟权限后，系统发此广播。
                     不监听的话已排闹钟不会按新权限重排（撤销时系统还会清掉本应用的精确闹钟），
                     只能等下次打开 App 才恢复。 -->
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 专注倒计时常驻前台服务 -->
        <service
            android:name=".notification.FocusTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="focus_timer_countdown" />
        </service>

        <!-- 长图 / ICS / 备份分享（FileProvider，替代网络传输） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
