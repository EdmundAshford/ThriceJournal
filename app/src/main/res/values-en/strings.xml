    <!-- About -->
    <string name="about_intro_line1">A simple tool for daily life and time management:</string>
    <string name="about_feature_schedule">· Schedule: smart timetable import, weekly grid, reschedule marks, widgets, pre-class reminders</string>
    <string name="about_feature_tasks">· Tasks: date-based to-dos with recurrence and split completion</string>
    <string name="about_feature_bills">· Bills: bookkeeping, categories and charts</string>
    <string name="about_feature_focus">· Focus: stopwatch and countdown, leave policy, finish notifications</string>
    <string name="about_feature_sleep">· Sleep: night and nap goals, reminders and hit-rate stats</string>
    <string name="about_feature_notes">· Notes: Markdown notes, folders, per-note font and size</string>
    <string name="about_feature_ai">· AI: bring your own AI; it reads and writes local data only with your permission</string>
    <string name="about_feature_personal">· Personalization: themes, custom wallpaper, fonts and reminders</string>
    <string name="about_local_only">Data stays on this device by default. AI contacts only the provider you choose, only when you use it. Ad-free.</string>
    <string name="about_open_source_hint">Fully open source and free. Issues and PRs are welcome on GitHub.</string>
    <string name="about_star_button">⭐ GitHub repository</string>
